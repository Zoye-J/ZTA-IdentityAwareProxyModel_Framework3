# Framework 3 Security Configuration
# Use the SAME secret across ALL services

# IMPORTANT: All services must use the same JWT_SECRET
JWT_SECRET=my-fixed-secret-key-for-framework3-2025-please-change-this

# Internal API Token - same across all services
INTERNAL_API_TOKEN=my-internal-token-for-service-auth-2025

# Flask Session Secret
FLASK_SECRET=my-flask-session-secret-2025

# Environment
ENVIRONMENT=development
DEBUG=False